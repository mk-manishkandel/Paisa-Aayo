    <!-- Onboarding -->
    <string name="onb_lang_title">Choose your language</string>
    <string name="onb_lang_body">You can change this anytime in Settings.</string>
    <string name="lang_nepali" translatable="false">नेपाली</string>
    <string name="lang_english" translatable="false">English</string>
    <string name="lang_nepali_sample" translatable="false">पाँच सय रुपैयाँ प्राप्त भयो</string>
    <string name="lang_english_sample" translatable="false">Received five hundred rupees</string>
    <string name="onb_welcome_title">Paisa Aayo!</string>
    <string name="onb_welcome_body">Your phone announces every payment you receive on eSewa, Khalti, Fonepay QR and bank SMS, out loud.</string>
    <string name="onb_point_offline_title">Works offline</string>
    <string name="onb_point_offline_body">No internet permission. Your payment data never leaves this phone.</string>
    <string name="onb_point_free_title">Free and open source</string>
    <string name="onb_point_free_body">No ads, no accounts, no tracking.</string>
    <string name="onb_point_voice_title">Speaks Nepali and English</string>
    <string name="onb_point_voice_body">Clear announcements, even for lakhs and crores.</string>
    <string name="onb_access_title">Allow notification access</string>
    <string name="onb_access_body">To announce payments, Paisa Aayo needs to read the notifications on this phone. It checks each new notification for a payment message. For each payment it keeps only the amount, the app\'s name, the reference number and the time, on this phone. Nothing is ever sent off the phone. Chats, email and social apps are always ignored.</string>
    <string name="onb_access_steps">On the next screen, find Paisa Aayo and turn it on.</string>
    <string name="onb_access_button">Agree and open settings</string>
    <string name="onb_access_granted">Access granted</string>
    <string name="onb_restricted_hint">Switch greyed out? Open App info, tap the ⋮ menu, choose \"Allow restricted settings\", then try again.</string>
    <string name="onb_app_info_button">Open app info</string>
    <string name="onb_notify_title">Allow notifications</string>
    <string name="onb_notify_body">A small, silent notification helps Android keep Paisa Aayo running in the background.</string>
    <string name="onb_notify_button">Allow notifications</string>
    <string name="onb_notify_granted">Notifications allowed</string>
    <string name="onb_battery_title">Keep it running</string>
    <string name="onb_battery_body">Some phones stop background apps to save battery. Let Paisa Aayo run so you never miss a payment.</string>
    <string name="onb_battery_button">Allow background use</string>
    <string name="onb_battery_done">Battery optimisation is off</string>
    <string name="onb_autostart_hint">On %1$s phones, also turn on Auto-start for Paisa Aayo.</string>
    <string name="onb_autostart_button">Open auto-start settings</string>
    <string name="onb_test_title">Let\'s test it</string>
    <string name="onb_test_body">Turn the volume up and tap the button. You should hear a sample payment.</string>
