    <string name="app_name">पैसा आयो</string>
    <string name="listener_label">पैसा आयो भुक्तानी सेवा</string>

    <!-- Onboarding -->
    <string name="onb_lang_title">आफ्नो भाषा छान्नुहोस्</string>
    <string name="onb_lang_body">यसलाई सेटिङमा जुनसुकै बेला बदल्न सकिन्छ।</string>
    <string name="onb_welcome_title">पैसा आयो!</string>
    <string name="onb_welcome_body">eSewa, Khalti, Fonepay QR र बैंक SMS मा आएको हरेक भुक्तानी तपाईंको फोनले ठूलो स्वरमा सुनाउँछ।</string>
    <string name="onb_point_offline_title">इन्टरनेट बिना चल्छ</string>
    <string name="onb_point_offline_body">इन्टरनेट अनुमति छैन। तपाईंको भुक्तानी विवरण यो फोनबाहिर जाँदैन।</string>
    <string name="onb_point_free_title">निःशुल्क र खुला स्रोत</string>
    <string name="onb_point_free_body">विज्ञापन, खाता वा ट्र्याकिङ केही छैन।</string>
    <string name="onb_point_voice_title">नेपाली र अंग्रेजीमा बोल्छ</string>
    <string name="onb_point_voice_body">लाख र करोडसम्मको रकम पनि प्रस्ट सुनाउँछ।</string>
    <string name="onb_access_title">सूचना पहुँच दिनुहोस्</string>
    <string name="onb_access_body">भुक्तानी सुनाउन पैसा आयोले यो फोनका सूचनाहरू पढ्नुपर्छ। यसले हरेक नयाँ सूचनामा भुक्तानी सन्देश छ कि छैन जाँच्छ। हरेक भुक्तानीको रकम, एपको नाम, सन्दर्भ नम्बर र समय मात्र यही फोनमा राख्छ। केही पनि फोनबाहिर पठाइँदैन। च्याट, इमेल र सामाजिक एपहरू सधैं बेवास्ता गरिन्छन्।</string>
    <string name="onb_access_steps">अर्को स्क्रिनमा पैसा आयो खोजेर खोल्नुहोस्।</string>
    <string name="onb_access_button">सहमत छु, सेटिङ खोल्नुहोस्</string>
    <string name="onb_access_granted">पहुँच दिइयो</string>
    <string name="onb_restricted_hint">स्विच खुलेन? App info खोल्नुहोस्, ⋮ मेनु थिच्नुहोस्, \"Allow restricted settings\" छान्नुहोस् र फेरि प्रयास गर्नुहोस्।</string>
    <string name="onb_app_info_button">एप जानकारी खोल्नुहोस्</string>
    <string name="onb_notify_title">सूचना अनुमति दिनुहोस्</string>
    <string name="onb_notify_body">सानो, आवाजरहित सूचनाले पैसा आयोलाई पृष्ठभूमिमा चलिरहन मद्दत गर्छ।</string>
    <string name="onb_notify_button">सूचना अनुमति दिनुहोस्</string>
    <string name="onb_notify_granted">सूचना अनुमति दिइयो</string>
    <string name="onb_battery_title">सधैं चलिरहन दिनुहोस्</string>
    <string name="onb_battery_body">केही फोनले ब्याट्री बचाउन पृष्ठभूमिका एप बन्द गर्छन्। कुनै भुक्तानी नछुटोस् भनेर पैसा आयोलाई चल्न दिनुहोस्।</string>
    <string name="onb_battery_button">पृष्ठभूमि प्रयोग अनुमति दिनुहोस्</string>
    <string name="onb_battery_done">ब्याट्री अप्टिमाइजेसन बन्द छ</string>
    <string name="onb_autostart_hint">%1$s फोनमा पैसा आयोको Auto-start पनि खोल्नुहोस्।</string>
    <string name="onb_autostart_button">अटो-स्टार्ट सेटिङ खोल्नुहोस्</string>
    <string name="onb_test_title">परीक्षण गरौं</string>
    <string name="onb_test_body">भोल्युम बढाएर बटन थिच्नुहोस्। नमुना भुक्तानी सुनिनुपर्छ।</string>
    <string name="onb_test_button">परीक्षण भुक्तानी बजाउनुहोस्</string>
    <string name="onb_finish">पैसा आयो चलाउन सुरु गर्नुहोस्</string>
    <string name="onb_step_of">चरण %1$d / %2$d</string>
